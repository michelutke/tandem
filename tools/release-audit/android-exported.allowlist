# E00-28: components that may declare android:exported="true", one per line:
#   <fully-qualified component name> <required android:permission, or "-" for none>
#
# Blank lines and lines starting with # are ignored. A component is checked against the *merged*
# release manifest (build/intermediates/merged_manifests/release/AndroidManifest.xml), resolving
# a name starting with "." against the manifest's package attribute.

# Injected by the androidx.profileinstaller library (pulled in transitively by Compose tooling),
# not a Tandem component; DUMP is a signature|privileged permission only the system/shell can hold.
androidx.profileinstaller.ProfileInstallReceiver android.permission.DUMP

# Launcher activity (E00-03); must be exported for the home screen, needs no permission.
dev.tandem.app.MainActivity -

# BOOT_COMPLETED/MY_PACKAGE_REPLACED restart receiver (E20-08); exported so the system can deliver
# BOOT_COMPLETED (not direct-boot aware), action-checked in onReceive rather than permission-guarded.
dev.tandem.app.service.BootReceiver -

# NotificationListenerService (E30-02, F-5.1); exported so the system can bind it, guarded by
# BIND_NOTIFICATION_LISTENER_SERVICE so no other app can.
dev.tandem.feature.notifications.TandemNotificationListenerService android.permission.BIND_NOTIFICATION_LISTENER_SERVICE

# Share-sheet target (ACTION_SEND) and PROCESS_TEXT entry point (E31-06, F-6.2/F-6.3); exported so
# the system can resolve them from another app's share sheet / the text-selection menu, no
# permission guard needed.
dev.tandem.feature.clipboard.ShareTargetActivity -
dev.tandem.feature.clipboard.ProcessTextActivity -

# Share-sheet target for files (E40-11, F-7.3); exported so the system can resolve it from another
# app's share sheet, no permission guard needed.
dev.tandem.feature.files.ShareFilesActivity -

# Quick Settings "Send clip" tile (E31-12); only the system may bind it.
dev.tandem.feature.clipboard.ClipboardTileService android.permission.BIND_QUICK_SETTINGS_TILE

# AccessibilityService for remote input (E62-02, F-9.3); exported so the system can bind it,
# guarded by BIND_ACCESSIBILITY_SERVICE so no other app can.
dev.tandem.feature.input.TandemAccessibilityService android.permission.BIND_ACCESSIBILITY_SERVICE

# Opt-in copy detector for clipboard auto-capture (ADR-007, D-82); exported so the system can bind it,
# guarded by BIND_ACCESSIBILITY_SERVICE so no other app can. Separate from the remote-input service.
dev.tandem.feature.clipboard.ClipboardCaptureService android.permission.BIND_ACCESSIBILITY_SERVICE
