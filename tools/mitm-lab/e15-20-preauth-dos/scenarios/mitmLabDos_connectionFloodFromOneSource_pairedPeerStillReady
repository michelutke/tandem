#!/usr/bin/env bash
# mitm-scenario-name: mitmLabDos_connectionFloodFromOneSource_pairedPeerStillReady
# mitm-scenario-role: client
# mitm-scenario-expect: handshakeRejected
# mitm-scenario-timeout: 180
#
# E15-20 (3/5): 20 idle connections from one source (127.0.0.2). SPEC.md §10 (E01-22): <= 2 not-yet-
# Ready connections per source IP and <= 8 total; excess sockets are closed on accept. While the flood
# is held, a paired client from another source (127.0.0.3) must reach Ready within 5 s.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-20-common.sh
source "$here/../lib/e15-20-common.sh"
trap e15_20_teardown EXIT

e15_20_require_alias 127.0.0.2
e15_20_require_alias 127.0.0.3
e15_20_setup
e15_20_launch_plain

paired_fp="$(e15_20_gen_cert_fp "$E15_20_TMP_DIR/paired")"
e15_20_seed_trust "$paired_fp" "E15-20 paired"

FAILED=0
PER_SOURCE_CAP=2
FLOOD=20

e15_20_probe hold 127.0.0.2 "$FLOOD" 12000 > "$E15_20_TMP_DIR/hold.out" &
hold_pid=$!

waited=0
while ! grep -q '^SETTLED' "$E15_20_TMP_DIR/hold.out" 2>/dev/null; do
  sleep 0.2
  waited=$((waited + 1))
  if [ "$waited" -gt 100 ]; then
    e15_20_log "FAIL: flood probe never settled"
    FAILED=1
    break
  fi
done

if [ "$FAILED" -eq 0 ]; then
  settled="$(grep '^SETTLED' "$E15_20_TMP_DIR/hold.out")"
  e15_20_log "flood of $FLOOD from 127.0.0.2: $settled"
  open_count="$(printf '%s' "$settled" | awk '{print $3}')"
  if [ "$open_count" -gt "$PER_SOURCE_CAP" ]; then
    e15_20_log "FAIL: $open_count flood connections stayed open, per-source cap is $PER_SOURCE_CAP (Mac does not enforce the E01-22 per-source limit)"
    FAILED=1
  else
    e15_20_log "OK: $open_count open (cap $PER_SOURCE_CAP), the remaining $((FLOOD - open_count)) closed on accept"
  fi

  e15_20_expect_ready 127.0.0.3 "$E15_20_TMP_DIR/paired-cert.pem" "$E15_20_TMP_DIR/paired-key.pem" 5000 || {
    e15_20_log "FAIL: paired peer from 127.0.0.3 did not reach Ready within 5 s during the flood"
    FAILED=1
  }
fi

wait "$hold_pid" 2>/dev/null
e15_20_assert_mac_alive || FAILED=1

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: handshakeRejected"
else
  echo "OUTCOME: FAILED"
fi
