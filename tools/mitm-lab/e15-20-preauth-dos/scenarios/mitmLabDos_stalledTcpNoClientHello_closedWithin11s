#!/usr/bin/env bash
# mitm-scenario-name: mitmLabDos_stalledTcpNoClientHello_closedWithin11s
# mitm-scenario-role: client
# mitm-scenario-expect: handshakeRejected
# mitm-scenario-timeout: 180
#
# E15-20 (1/5): TCP connect, then silence -- no ClientHello ever. SPEC.md §10 (E01-22): the Mac's TLS
# handshake deadline is 10 s from TCP accept, so the connection MUST be closed within 11 s. A paired
# peer from another source must still reach Ready afterward (positive control).
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-20-common.sh
source "$here/../lib/e15-20-common.sh"
trap e15_20_teardown EXIT

e15_20_require_alias 127.0.0.2
e15_20_require_alias 127.0.0.3
e15_20_setup
e15_20_launch_plain

paired_fp="$(e15_20_gen_cert_fp "$E15_20_TMP_DIR/paired")"
e15_20_seed_trust "$paired_fp" "E15-20 paired"

FAILED=0
CLOSE_BOUND_MS=11000

out="$(e15_20_probe tcp-silent 127.0.0.2 14000)"
e15_20_log "stalled TCP connection: $out"
closed_ms="${out#CLOSED_MS }"
if [ "$closed_ms" = "$out" ]; then
  e15_20_log "FAIL: stalled connection was not closed within the 14 s observation window: $out"
  FAILED=1
elif [ "$closed_ms" -gt "$CLOSE_BOUND_MS" ]; then
  e15_20_log "FAIL: stalled connection closed after ${closed_ms}ms, bound is ${CLOSE_BOUND_MS}ms"
  FAILED=1
else
  e15_20_log "OK: stalled connection closed after ${closed_ms}ms (<= ${CLOSE_BOUND_MS}ms)"
fi

e15_20_assert_mac_alive || FAILED=1
e15_20_expect_ready 127.0.0.3 "$E15_20_TMP_DIR/paired-cert.pem" "$E15_20_TMP_DIR/paired-key.pem" || {
  e15_20_log "FAIL: paired peer did not reach Ready after the stalled connection"
  FAILED=1
}

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: handshakeRejected"
else
  echo "OUTCOME: FAILED"
fi
