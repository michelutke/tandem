#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_badProofRejection_wireReasonPairingUnavailableOnly
# mitm-scenario-role: client
# mitm-scenario-expect: noPairAccepted
# mitm-scenario-timeout: 240
#
# E15-09 (9/9): a bad proof, asserting the wire reason is `PAIRING_UNAVAILABLE` only.
#
# SPEC.md #pairing "`PairRejected` wire collapse": no wire value distinguishes a bad proof from an
# expired window from a malformed request -- every one of `EXPIRED`/`BAD_PROOF`/`MALFORMED` collapses
# to `PAIR_REJECTED_REASON_PAIRING_UNAVAILABLE`, and every case closes with `PAIRING_FAILED`
# (`docs/planning/decisions.md` D-72). This scenario sends a random (definitely wrong) proof and
# asserts the observed reason is *exactly* `PAIR_REJECTED_REASON_PAIRING_UNAVAILABLE` -- never
# `PAIR_REJECTED_REASON_REJECTED_BY_OWNER` (the Mac-side-decline reason, which never applies to a
# rejection the Mac itself decided before any confirmation dialog existed) and never the zero-value
# `PAIR_REJECTED_REASON_UNSPECIFIED`, which invariant 6/D-72 both forbid ever appearing on the wire.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-09-common.sh
source "$here/../lib/e15-09-common.sh"
trap e15_09_teardown EXIT
e15_09_setup

FAILED=0
e15_09_start_client

open_response="$(e15_09_rawopen 127.0.0.1 "$MAC_PORT" "$MAC_FP_B64")"
case "$open_response" in
  "OK OPENED "*) ;;
  *)
    e15_09_log "FAIL: not admitted as a pairing candidate: $open_response"
    FAILED=1
    ;;
esac

if [ "$FAILED" -eq 0 ]; then
  bad_proof_hex="$(openssl rand -hex 32)"
  e15_09_rawsendproof "$bad_proof_hex"
  e15_09_log "bad-proof outcome: $LAST_PAIR_EVENT"
  case "$LAST_PAIR_EVENT" in
    "EVENT PAIR_REJECTED PAIR_REJECTED_REASON_PAIRING_UNAVAILABLE")
      e15_09_log "OK: observed reason is exactly PAIRING_UNAVAILABLE"
      ;;
    "EVENT PAIR_REJECTED"*)
      e15_09_log "FAIL: observed a PairRejected reason other than PAIRING_UNAVAILABLE: $LAST_PAIR_EVENT"
      FAILED=1
      ;;
    *)
      e15_09_log "FAIL: expected a PairRejected(PAIRING_UNAVAILABLE), got: $LAST_PAIR_EVENT"
      FAILED=1
      ;;
  esac
fi

e15_09_stop_client

TRUST_COUNT="$(e15_09_trust_record_count)"
if [ "$TRUST_COUNT" != "0" ]; then
  e15_09_log "FAIL: expected 0 Mac trust records, found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: noPairAccepted"
else
  echo "OUTCOME: FAILED"
fi
