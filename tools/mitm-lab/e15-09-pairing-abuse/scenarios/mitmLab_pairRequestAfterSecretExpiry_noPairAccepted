#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_pairRequestAfterSecretExpiry_noPairAccepted
# mitm-scenario-role: client
# mitm-scenario-expect: noPairAccepted
# mitm-scenario-timeout: 300
#
# E15-09 (2/9): attempt pairing after the secret's 120 s expiry -- a real wall-clock wait, since the
# real Mac app runs on the system clock (no debug override exists for the window's duration).
#
# SPEC.md #pairing distinguishes two different timers that could be confused here: the phone MUST
# reply with `PairRequest` within 10 s of *this connection's own* hello exchange (a per-connection
# deadline, "Frame order on a pairing-candidate connection"), while the pairing *window* itself
# (opened once, at Mac launch) expires 120 s after it opened, destroying the secret ("Pairing
# window"). Connecting late enough that the window has already expired before the TLS handshake
# even reaches the verify callback would just get rejected as `handshakeRejected` (no window open at
# all -- the same path E15-09 scenarios 3/4/8 exercise), which would not distinguish "expired" from
# "no window" at all. To exercise expiry specifically, this scenario connects *before* the window
# expires (t=114s, still comfortably a pairing candidate, well within the window's own 120 s and
# with this connection's own fresh 10 s local deadline not starting until its hello completes here),
# then deliberately waits past the window's global 120 s mark (to t=121s, still well inside this
# connection's own local 10 s-from-hello deadline, which now runs to ~t=124s) before finally sending
# a *correctly computed* proof. The Mac's own proof verifier checks the window's absolute expiry
# first, so this must be rejected as `EXPIRED` (wire-collapsed to `PAIRING_UNAVAILABLE`,
# `docs/planning/decisions.md` D-72), not accepted just because the proof itself is correct.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-09-common.sh
source "$here/../lib/e15-09-common.sh"
trap e15_09_teardown EXIT
e15_09_setup

# T0: the moment the pairing window is known to already be open (setup already confirmed the Mac
# printed its QR URI, which only happens once the window is open).
T0=$(date +%s)
CONNECT_AT=114
SEND_AT=121

sleep_until() {
  local target="$1"
  local now
  now=$(date +%s)
  local remaining=$(( T0 + target - now ))
  if (( remaining > 0 )); then
    e15_09_log "sleeping ${remaining}s (real wall clock) to reach t=${target}s since the window opened"
    sleep "$remaining"
  fi
}

FAILED=0

e15_09_start_client
sleep_until "$CONNECT_AT"
open_response="$(e15_09_rawopen 127.0.0.1 "$MAC_PORT" "$MAC_FP_B64")"
case "$open_response" in
  "OK OPENED "*)
    e15_09_log "OK: admitted as a pairing candidate at t=$(( $(date +%s) - T0 ))s: $open_response"
    ;;
  *)
    e15_09_log "FAIL: expected to be admitted as a pairing candidate before expiry, got: $open_response"
    FAILED=1
    ;;
esac

if [ "$FAILED" -eq 0 ]; then
  sleep_until "$SEND_AT"
  e15_09_rawsend "$SECRET_B64URL"
  e15_09_log "post-expiry correct-proof outcome (t=$(( $(date +%s) - T0 ))s): $LAST_PAIR_EVENT"
  case "$LAST_PAIR_EVENT" in
    "EVENT PAIR_ACCEPTED")
      e15_09_log "FAIL: a PairRequest sent after the 120s window expiry was accepted"
      FAILED=1
      ;;
    "EVENT PAIR_REJECTED PAIR_REJECTED_REASON_PAIRING_UNAVAILABLE")
      e15_09_log "OK: rejected with the wire-collapsed PAIRING_UNAVAILABLE reason (EXPIRED, SPEC.md #pairing 'PairRejected wire collapse')"
      ;;
    *)
      e15_09_log "FAIL: expected PAIR_REJECTED PAIRING_UNAVAILABLE, got: $LAST_PAIR_EVENT"
      FAILED=1
      ;;
  esac
fi

e15_09_stop_client

TRUST_COUNT="$(e15_09_trust_record_count)"
if [ "$TRUST_COUNT" != "0" ]; then
  e15_09_log "FAIL: expected 0 Mac trust records, found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: noPairAccepted"
else
  echo "OUTCOME: FAILED"
fi
