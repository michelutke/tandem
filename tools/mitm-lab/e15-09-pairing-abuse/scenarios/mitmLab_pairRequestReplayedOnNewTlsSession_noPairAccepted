#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_pairRequestReplayedOnNewTlsSession_noPairAccepted
# mitm-scenario-role: client
# mitm-scenario-expect: noPairAccepted
# mitm-scenario-timeout: 240
#
# E15-09 (6/9): channel binding -- a real proof computed with the *current* session's own
# `macSpkiDer`/`phoneSpkiDer` but an *old* session's `cb` must never verify.
#
# SPEC.md #pairing "Proof computation"/"Channel binding": `cb` is exactly the 32 bytes of the
# `PairChallenge` sent on *this* connection, and the transcript binds the proof to it. A pairing
# candidate connection is opened (its `PairChallenge` value is `cb1`), then closed before sending
# any `PairRequest` (burning one of the window's 3 attempts, SPEC.md #pairing "Pairing window"). A
# fresh pairing candidate connection is then opened on the same phone identity (its own
# `PairChallenge` value is `cb2`, necessarily different from `cb1`): a real proof is computed with
# the real secret and the real `PairingProof.compute`, using this *second* session's real
# `macSpkiDer`/`phoneSpkiDer` (SPEC.md: `phoneSpkiDer` is always taken from the certificate seen on
# *this* handshake) but `cb1` (the *first* session's channel-binding value) instead of `cb2`
# (`RAWSEND`'s `CB=<hex>` override, HarnessCli.kt). Because the Mac always recomputes the proof over
# the `cb` it itself generated and sent on *this* connection, this necessarily produces `BAD_PROOF`,
# collapsing on the wire to `PAIR_REJECTED_REASON_PAIRING_UNAVAILABLE` (SPEC.md #pairing
# "`PairRejected` wire collapse").
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-09-common.sh
source "$here/../lib/e15-09-common.sh"
trap e15_09_teardown EXIT
e15_09_setup

FAILED=0
e15_09_start_client

open1_response="$(e15_09_rawopen 127.0.0.1 "$MAC_PORT" "$MAC_FP_B64")"
e15_09_log "first RAWOPEN (cb1 session): $open1_response"
case "$open1_response" in
  "OK OPENED "*)
    CB1_HEX="${open1_response#OK OPENED }"
    ;;
  *)
    e15_09_log "FAIL: first RAWOPEN did not open a pairing candidate with a captured challenge: $open1_response"
    FAILED=1
    ;;
esac

if [ "$FAILED" -eq 0 ]; then
  # Close cb1's session without ever sending a PairRequest -- burns one attempt (SPEC.md #pairing
  # "Pairing window" last bullet), freeing the candidate slot for the second connection below.
  e15_09_send "RAWCLOSE"
  e15_09_read 5 >/dev/null || true

  open2_response="$(e15_09_rawopen 127.0.0.1 "$MAC_PORT" "$MAC_FP_B64")"
  e15_09_log "second RAWOPEN (cb2 session): $open2_response"
  case "$open2_response" in
    "OK OPENED "*)
      CB2_HEX="${open2_response#OK OPENED }"
      if [ "$CB2_HEX" = "$CB1_HEX" ]; then
        e15_09_log "FAIL: cb2 equals cb1 -- the Mac did not issue a fresh PairChallenge on the second connection"
        FAILED=1
      fi
      ;;
    *)
      e15_09_log "FAIL: second RAWOPEN did not open a pairing candidate with a captured challenge -- the channel-binding test was never attempted: $open2_response"
      FAILED=1
      ;;
  esac
fi

if [ "$FAILED" -eq 0 ]; then
  e15_09_rawsend "$SECRET_B64URL CB=$CB1_HEX"
  e15_09_log "real proof computed over cb1, sent on cb2's session -- outcome: $LAST_PAIR_EVENT"
  case "$LAST_PAIR_EVENT" in
    "EVENT PAIR_REJECTED PAIR_REJECTED_REASON_PAIRING_UNAVAILABLE")
      e15_09_log "OK: a proof bound to the wrong session's channel-binding value was rejected"
      ;;
    "EVENT PAIR_ACCEPTED")
      e15_09_log "FAIL: a proof bound to the wrong session's cb was accepted"
      FAILED=1
      ;;
    *)
      e15_09_log "FAIL: expected PAIR_REJECTED(PAIRING_UNAVAILABLE), got: $LAST_PAIR_EVENT"
      FAILED=1
      ;;
  esac
fi

e15_09_stop_client

TRUST_COUNT="$(e15_09_trust_record_count)"
if [ "$TRUST_COUNT" != "0" ]; then
  e15_09_log "FAIL: expected 0 Mac trust records, found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: noPairAccepted"
else
  echo "OUTCOME: FAILED"
fi
