#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_manualPairing_messageInQrPairingSession_connectionClosed
# mitm-scenario-role: client
# mitm-scenario-expect: noPairAccepted
# mitm-scenario-timeout: 240
#
# E73-05 (4/4): a QR pairing attempt cannot be downgraded into manual pairing.
#
# ADR-008 "Downgrade resistance": the window mode is fixed at open, a QR window accepts only the QR
# sequence. A manual-pairing `Commitment` injected into a QR pairing session is a wrong payload: the
# Mac answers PairRejected, closes the connection (PAIRING_FAILED) and never sends a `Commitment` of
# its own. No trust record may exist at the end.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e73-05-common.sh
source "$here/../lib/e73-05-common.sh"
trap e15_09_teardown EXIT
e15_09_setup

FAILED=0
e15_09_start_client

open_response="$(e15_09_rawopen 127.0.0.1 "$MAC_PORT" "$MAC_FP_B64")"
case "$open_response" in
  "OK OPENED "*) ;;
  *)
    e73_05_log "FAIL: not admitted as a QR pairing candidate: $open_response"
    FAILED=1
    ;;
esac

if [ "$FAILED" -eq 0 ]; then
  e73_05_manual COMMIT
  e73_05_log "Commitment-in-QR-session outcome: $LAST_PAIR_EVENT"
  if e73_05_event_is_rejection "$LAST_PAIR_EVENT"; then
    e73_05_log "OK: QR session closed on the manual message"
  else
    e73_05_log "FAIL: expected the QR session to be rejected/closed, got: $LAST_PAIR_EVENT"
    FAILED=1
  fi
fi

e15_09_stop_client

TRUST_COUNT="$(e15_09_trust_record_count)"
if [ "$TRUST_COUNT" != "0" ]; then
  e73_05_log "FAIL: expected 0 Mac trust records, found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: noPairAccepted"
else
  echo "OUTCOME: FAILED"
fi
