#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_manualPairing_commitPhaseSkipped_rejectedNoPin
# mitm-scenario-role: client
# mitm-scenario-expect: noPairAccepted
# mitm-scenario-timeout: 240
#
# E73-05 (2/4): a peer that sends `Reveal` without a prior `Commitment` (the commit phase skipped).
#
# ADR-008 step 4: a `Reveal` before the peer's `Commitment` is an out-of-order message, rejected with
# PAIRING_FAILED and one burned attempt. The Mac must never answer with a `Commitment` or `Reveal`
# of its own, never produce a `ManualPairResult`, and must leave no trust record.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e73-05-common.sh
source "$here/../lib/e73-05-common.sh"
trap e15_09_teardown EXIT
e73_05_setup_manual

FAILED=0
e15_09_start_client

open_response="$(e73_05_open)"
case "$open_response" in
  "OK OPENED "*) ;;
  *)
    e73_05_log "FAIL: not admitted as a pairing candidate: $open_response"
    FAILED=1
    ;;
esac

if [ "$FAILED" -eq 0 ]; then
  e73_05_manual "REVEAL NONCE=$(openssl rand -hex 16)"
  e73_05_log "Reveal-without-Commitment outcome: $LAST_PAIR_EVENT"
  if [ "$LAST_PAIR_EVENT" = "EVENT MAC_COMMITMENT" ]; then
    e73_05_log "FAIL: the Mac sent a Commitment in answer to a Reveal with no Commitment"
    FAILED=1
  elif e73_05_event_is_rejection "$LAST_PAIR_EVENT"; then
    e73_05_log "OK: connection ended without a ManualPairResult"
  else
    e73_05_log "FAIL: expected a rejection, got: $LAST_PAIR_EVENT"
    FAILED=1
  fi
fi

e15_09_stop_client

TRUST_COUNT="$(e15_09_trust_record_count)"
if [ "$TRUST_COUNT" != "0" ]; then
  e73_05_log "FAIL: expected 0 Mac trust records, found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: noPairAccepted"
else
  echo "OUTCOME: FAILED"
fi
