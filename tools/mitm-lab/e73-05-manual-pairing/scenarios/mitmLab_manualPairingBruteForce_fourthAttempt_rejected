#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_manualPairingBruteForce_fourthAttempt_rejected
# mitm-scenario-role: client
# mitm-scenario-expect: handshakeRejected
# mitm-scenario-timeout: 240
#
# E73-05 (1/4): brute-forcing the manual-pairing SAS is bounded by the pairing window's 3 attempts.
#
# ADR-008: manual pairing reuses the UC-03 window unchanged (120 s, 3 attempts). Each attempt here
# completes the real commit phase, then reveals a wrong nonce, which the Mac rejects and which burns
# one attempt (a guess at the SAS that never even reaches the compare step). After the third, the
# window is closed and the 4th TLS connection is rejected in the verify callback, never becoming a
# pairing candidate (AC-03). No trust record may exist at the end.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e73-05-common.sh
source "$here/../lib/e73-05-common.sh"
trap e15_09_teardown EXIT
e73_05_setup_manual

FAILED=0
e15_09_start_client

for attempt in 1 2 3; do
  open_response="$(e73_05_open)"
  case "$open_response" in
    "OK OPENED "*) ;;
    *)
      e73_05_log "FAIL: attempt $attempt not admitted as a pairing candidate: $open_response"
      FAILED=1
      break
      ;;
  esac
  e73_05_manual COMMIT
  e73_05_log "attempt $attempt commit: $LAST_OK / $LAST_PAIR_EVENT"
  if [ "$LAST_PAIR_EVENT" != "EVENT MAC_COMMITMENT" ]; then
    e73_05_log "FAIL: attempt $attempt did not get the Mac's commitment: $LAST_PAIR_EVENT"
    FAILED=1
    break
  fi
  e73_05_manual "REVEAL NONCE=$(openssl rand -hex 16)"
  e73_05_log "attempt $attempt wrong reveal: $LAST_PAIR_EVENT"
  if ! e73_05_event_is_rejection "$LAST_PAIR_EVENT"; then
    e73_05_log "FAIL: attempt $attempt with a wrong nonce was not rejected: $LAST_PAIR_EVENT"
    FAILED=1
    break
  fi
done

if [ "$FAILED" -eq 0 ]; then
  fourth_response="$(e73_05_open)"
  e73_05_log "4th attempt RAWOPENUNPINNED: $fourth_response"
  case "$fourth_response" in
    "ERROR HANDSHAKE_REJECTED"*)
      e73_05_log "OK: 4th candidate connection rejected, window exhausted"
      e15_09_assert_mac_alive || FAILED=1
      ;;
    *)
      e73_05_log "FAIL: expected the 4th attempt to be rejected at the handshake, got: $fourth_response"
      FAILED=1
      ;;
  esac
fi

e15_09_stop_client

TRUST_COUNT="$(e15_09_trust_record_count)"
if [ "$TRUST_COUNT" != "0" ]; then
  e73_05_log "FAIL: expected 0 Mac trust records, found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: handshakeRejected"
else
  echo "OUTCOME: FAILED"
fi
