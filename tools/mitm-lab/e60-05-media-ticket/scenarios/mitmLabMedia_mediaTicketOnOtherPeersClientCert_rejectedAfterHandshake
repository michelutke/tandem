#!/usr/bin/env bash
# mitm-scenario-name: mitmLabMedia_mediaTicketOnOtherPeersClientCert_rejectedAfterHandshake
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(TICKET_REJECTED)
# mitm-scenario-timeout: 240
#
# E60-05 (5/6): a ticket issued to paired peer A's control session is presented on a media connection
# authenticated with paired peer B's client certificate (B completes mTLS, it is paired too).
# Invariant 3: the ticket is bound to A's SPKI; rejected as `peerMismatch`.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e60-05-common.sh
source "$here/../lib/e60-05-common.sh"
trap e60_05_teardown EXIT

e60_05_setup
FAILED=0

e60_05_open_control || FAILED=1
if [ "$FAILED" -eq 0 ]; then
  e60_05_request_ticket || FAILED=1
fi
if [ "$FAILED" -eq 0 ]; then
  e60_05_media_open B "$E60_05_TICKET" || FAILED=1
  e60_05_assert_rejected peerMismatch || FAILED=1
  e60_05_assert_bound_count 0 || FAILED=1
fi
e15_10_assert_mac_alive "$PORT" || FAILED=1
e60_05_finish TICKET_REJECTED
