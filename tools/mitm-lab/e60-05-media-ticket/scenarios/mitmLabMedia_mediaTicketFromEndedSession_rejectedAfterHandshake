#!/usr/bin/env bash
# mitm-scenario-name: mitmLabMedia_mediaTicketFromEndedSession_rejectedAfterHandshake
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(TICKET_REJECTED)
# mitm-scenario-timeout: 240
#
# E60-05 (4/6): a ticket issued on a control session that has since ended is presented (within 30 s)
# on a media connection. The Mac revokes a session's tickets when it ends; the acceptor reports the
# revoked ticket as `otherSession` (revoked and peerMismatch share that local reason).
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e60-05-common.sh
source "$here/../lib/e60-05-common.sh"
trap e60_05_teardown EXIT

e60_05_setup
FAILED=0

e60_05_open_control || FAILED=1
if [ "$FAILED" -eq 0 ]; then
  e60_05_request_ticket || FAILED=1
fi
if [ "$FAILED" -eq 0 ]; then
  e15_10_send "RAWCLOSE"
  e15_10_read 5 >/dev/null || true
  sleep 3
  e60_05_media_open A "$E60_05_TICKET" || FAILED=1
  e60_05_assert_rejected otherSession || FAILED=1
  e60_05_assert_bound_count 0 || FAILED=1
fi
e15_10_assert_mac_alive "$PORT" || FAILED=1
e60_05_finish TICKET_REJECTED
