#!/usr/bin/env bash
# mitm-scenario-name: mitmLabMedia_mediaTicketAfter31s_rejectedAfterHandshake
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(TICKET_REJECTED)
# mitm-scenario-timeout: 300
#
# E60-05 (3/6): a valid ticket is presented 31 s after issuance. SPEC.md #media-ticket validity is
# 30 s from issuance: rejected as `expired`.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e60-05-common.sh
source "$here/../lib/e60-05-common.sh"
trap e60_05_teardown EXIT

e60_05_setup
FAILED=0

e60_05_open_control || FAILED=1
if [ "$FAILED" -eq 0 ]; then
  e60_05_request_ticket || FAILED=1
fi
if [ "$FAILED" -eq 0 ]; then
  sleep 31
  e60_05_media_open A "$E60_05_TICKET" || FAILED=1
  e60_05_assert_rejected expired || FAILED=1
  e60_05_assert_bound_count 0 || FAILED=1
fi
e15_10_assert_mac_alive "$PORT" || FAILED=1
e60_05_finish TICKET_REJECTED
