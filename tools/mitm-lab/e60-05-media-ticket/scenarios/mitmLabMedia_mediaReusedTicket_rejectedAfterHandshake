#!/usr/bin/env bash
# mitm-scenario-name: mitmLabMedia_mediaReusedTicket_rejectedAfterHandshake
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(TICKET_REJECTED)
# mitm-scenario-timeout: 240
#
# E60-05 (2/6): a valid ticket is used once (the first media connection is bound), then presented
# again on a second connection. SPEC.md #media-ticket single use: rejected as `consumed`.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e60-05-common.sh
source "$here/../lib/e60-05-common.sh"
trap e60_05_teardown EXIT

e60_05_setup
FAILED=0

e60_05_open_control || FAILED=1
if [ "$FAILED" -eq 0 ]; then
  e60_05_request_ticket || FAILED=1
fi
if [ "$FAILED" -eq 0 ]; then
  e60_05_media_open A "$E60_05_TICKET" HOLD || FAILED=1
  e15_10_wait_for_log_line 'harness-media-event: bound' 10 >/dev/null || { e60_05_log "FAIL: first use was not bound"; FAILED=1; }
fi
if [ "$FAILED" -eq 0 ]; then
  e60_05_media_open A "$E60_05_TICKET" || FAILED=1
  e60_05_assert_rejected consumed || FAILED=1
  e60_05_assert_bound_count 1 || FAILED=1
fi
e15_10_assert_mac_alive "$PORT" || FAILED=1
e60_05_finish TICKET_REJECTED
