#!/usr/bin/env bash
# mitm-scenario-name: mitmLabMedia_mediaHelloWithoutTicket_rejectedAfterHandshake
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(TICKET_REJECTED)
# mitm-scenario-timeout: 240
#
# E60-05 (1/6): a paired peer completes mTLS on a media connection and sends a `MediaHello` with no
# ticket. SPEC.md #media-ticket: rejected as `missing`; the connection is closed, nothing is bound.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e60-05-common.sh
source "$here/../lib/e60-05-common.sh"
trap e60_05_teardown EXIT

e60_05_setup
FAILED=0

e60_05_media_open A NONE || FAILED=1
e60_05_assert_rejected missing || FAILED=1
e60_05_assert_bound_count 0 || FAILED=1
e15_10_assert_mac_alive "$PORT" || FAILED=1
e60_05_finish TICKET_REJECTED
