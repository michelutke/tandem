#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_inputAfterMirrorStopped_notInjectedAndLogged
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(INPUT_DROPPED)
# mitm-scenario-timeout: 600
#
# E62-08 (3/6): the mirror session is started by the user, its session reference captured, the
# session stopped (media connection closed), and a Tap carrying the now-stale reference is sent.
# Nothing is injected and exactly one drop is logged (NoConsent once the stop revoked the consent,
# MediaInactive if the gate saw the closed media connection first).
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e62-08-device.sh
source "$here/../lib/e62-08-device.sh"
trap e15_10_teardown EXIT

FAILED=0
e15_10_setup_mac
e62_08_setup_device
PORT="$(e15_10_free_port)"
e62_08_pair_phone "$PORT" || FAILED=1
if [ "$FAILED" -eq 0 ]; then
  e62_08_user_starts_mirror || FAILED=1
fi
if [ "$FAILED" -eq 0 ]; then
  e62_08_mirror_stops
  e62_08_begin_measure
  e62_08_send_input "$E62_08_PHONE_FP_HEX" TAP 1 1 "$E62_08_MIRROR_SESSION_HEX" || FAILED=1
  sleep "$E62_08_SETTLE_SECONDS"
  e62_08_assert_nothing_injected || FAILED=1
  case "$(e62_08_drop_lines)" in
    "input_dropped reason=NoConsent event=TAP" | "input_dropped reason=MediaInactive event=TAP") e62_08_log "OK: one drop log entry after stop" ;;
    *) e62_08_log "FAIL: expected one NoConsent/MediaInactive drop, phone logged: $(e62_08_drop_lines | tr '\n' ';')"; FAILED=1 ;;
  esac
fi
e15_10_assert_mac_alive "$PORT" || FAILED=1
e62_08_finish INPUT_DROPPED
