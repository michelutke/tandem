#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_phoneRevokedWhileOffline_zeroAppBytesDelivered
# mitm-scenario-role: client
# mitm-scenario-expect: handshakeRejected
# mitm-scenario-timeout: 240
#
# E15-10 (4/6, AC-09): a phone whose trust record was deleted on the Mac while it was offline
# (E14-13 local delete). Models the real timeline: the phone was genuinely paired (its fingerprint
# is seeded into the Mac's trust store), then -- while the phone has no active connection, i.e. is
# "offline" from the Mac's point of view -- the user deletes its trust record on the Mac itself
# (`-HarnessClearTrust`, the same local-delete hook E14-16's own trust-store tests exercise). The
# phone, still holding the same identity it was paired with, then attempts to reconnect: outside a
# pairing window, an unrecognized fingerprint is rejected at the TLS handshake, exactly like
# scenario 1's never-paired case.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-10-common.sh
source "$here/../lib/e15-10-common.sh"
trap e15_10_teardown EXIT

e15_10_setup_jvm
e15_10_setup_mac

FAILED=0

# The phone: start it once to learn its real identity (persisted in a fixed identity file so it can
# be restarted later with the exact same fingerprint), then stop it -- nothing about "seeding trust"
# requires the phone's own process to be running.
e15_10_start_client "phone-identity.bin"
PHONE_FP_HEX="$CLIENT_SPKI_HEX"
e15_10_stop_client
e15_10_log "phone identity: $PHONE_FP_HEX"

e15_10_seed_trust "$PHONE_FP_HEX" "the phone (about to be revoked while offline)" "$E15_10_TMP_DIR/seed-phone.json"

PORT=$(( (RANDOM % 20000) + 20000 ))
e15_10_launch_plain "$PORT"
MAC_FP_B64="$(e15_10_hex_to_b64url "$(harness_identity_spki)")"

# Sanity check the seeded trust actually took effect (strengthens the evidence this is a real
# revoke, not a scenario that would have rejected the phone either way): reconnecting now, before
# any revoke, must succeed.
e15_10_start_client "phone-identity.bin"
precheck_response="$(e15_10_rawopen 127.0.0.1 "$PORT" "$MAC_FP_B64")"
e15_10_log "pre-revoke RAWOPEN (sanity check the phone really is trusted): $precheck_response"
if [ "${precheck_response#OK OPENED}" = "$precheck_response" ]; then
  e15_10_log "FAIL: phone was not admitted even before the revoke -- seeding did not work"
  FAILED=1
fi
e15_10_stop_client

if [ "$FAILED" -eq 0 ]; then
  # "While it was offline": the phone has no active connection here (already stopped above). Delete
  # its trust record on the Mac (E14-13 local delete), then bring the Mac back up.
  TRUST_COUNT_BEFORE="$(e15_10_trust_record_count)"
  if [ "$TRUST_COUNT_BEFORE" != "1" ]; then
    e15_10_log "FAIL: expected exactly 1 trust record before the revoke, found $TRUST_COUNT_BEFORE"
    FAILED=1
  fi
  if ! harness_clear_trust; then
    e15_10_log "FAIL: -HarnessClearTrust exited non-zero"
    FAILED=1
  fi
  e15_10_relaunch_plain "$PORT"
fi

if [ "$FAILED" -eq 0 ]; then
  e15_10_start_client "phone-identity.bin"
  response="$(e15_10_rawopen 127.0.0.1 "$PORT" "$MAC_FP_B64")"
  e15_10_load_rawopen_ms
  e15_10_log "post-revoke reconnect RAWOPEN: $response (took ${E15_10_LAST_RAWOPEN_MS}ms)"
  case "$response" in
    "ERROR HANDSHAKE_REJECTED"*)
      e15_10_log "OK: the now-revoked phone's reconnect attempt was rejected at the TLS handshake -- no CONTROL frame, no application byte, was ever exchanged"
      ;;
    *)
      e15_10_log "FAIL: expected the handshake to be rejected, got: $response"
      FAILED=1
      ;;
  esac
  if [ "$E15_10_LAST_RAWOPEN_MS" -ge 5000 ]; then
    e15_10_log "FAIL: rejection took ${E15_10_LAST_RAWOPEN_MS}ms, expected < 5000ms"
    FAILED=1
  fi
  e15_10_assert_mac_alive "$PORT" || FAILED=1
  e15_10_stop_client
fi

TRUST_COUNT_AFTER="$(e15_10_trust_record_count)"
if [ "$TRUST_COUNT_AFTER" != "0" ]; then
  e15_10_log "FAIL: expected 0 Mac trust records after the revoke, found $TRUST_COUNT_AFTER"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: handshakeRejected"
else
  echo "OUTCOME: FAILED"
fi
