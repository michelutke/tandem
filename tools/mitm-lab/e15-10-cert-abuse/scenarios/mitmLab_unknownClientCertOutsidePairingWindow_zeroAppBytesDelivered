#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_unknownClientCertOutsidePairingWindow_zeroAppBytesDelivered
# mitm-scenario-role: client
# mitm-scenario-expect: handshakeRejected
# mitm-scenario-timeout: 240
#
# E15-10 (1/6): a client presenting a certificate whose SPKI fingerprint is not in the Mac's trust
# store, with no pairing window open. SPEC.md #pairing: outside a pairing window the Mac's verify
# callback only ever admits an already-trusted fingerprint -- an unknown one is rejected at the TLS
# handshake itself, before any CONTROL frame (let alone application data) is ever exchanged.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-10-common.sh
source "$here/../lib/e15-10-common.sh"
trap e15_10_teardown EXIT

e15_10_setup_jvm
e15_10_setup_mac

PORT=$(( (RANDOM % 20000) + 20000 ))
e15_10_launch_plain "$PORT"

MAC_SPKI_HEX="$(harness_identity_spki)"
if [ -z "$MAC_SPKI_HEX" ]; then
  e15_10_log "no harness-identity-spki line from the Mac app"
  exit 1
fi
MAC_FP_B64="$(e15_10_hex_to_b64url "$MAC_SPKI_HEX")"

FAILED=0
e15_10_start_client
e15_10_log "client identity (never seeded into the Mac's trust store): $CLIENT_SPKI_HEX"

response="$(e15_10_rawopen 127.0.0.1 "$PORT" "$MAC_FP_B64")"
e15_10_load_rawopen_ms
e15_10_log "RAWOPEN response: $response (took ${E15_10_LAST_RAWOPEN_MS}ms)"

case "$response" in
  "ERROR HANDSHAKE_REJECTED"*)
    e15_10_log "OK: unknown client cert rejected at the TLS handshake -- no CONTROL frame, no application byte, was ever exchanged"
    ;;
  *)
    e15_10_log "FAIL: expected the handshake to be rejected, got: $response"
    FAILED=1
    ;;
esac

if [ "$E15_10_LAST_RAWOPEN_MS" -ge 5000 ]; then
  e15_10_log "FAIL: rejection took ${E15_10_LAST_RAWOPEN_MS}ms, expected < 5000ms"
  FAILED=1
fi

e15_10_assert_mac_alive "$PORT" || FAILED=1

e15_10_stop_client

TRUST_COUNT="$(e15_10_trust_record_count)"
if [ "$TRUST_COUNT" != "0" ]; then
  e15_10_log "FAIL: expected 0 Mac trust records, found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: handshakeRejected"
else
  echo "OUTCOME: FAILED"
fi
