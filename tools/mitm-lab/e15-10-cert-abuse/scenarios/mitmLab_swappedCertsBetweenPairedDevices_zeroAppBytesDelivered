#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_swappedCertsBetweenPairedDevices_zeroAppBytesDelivered
# mitm-scenario-role: client
# mitm-scenario-expect: handshakeRejected
# mitm-scenario-timeout: 240
#
# E15-10 (3/6): certificates swapped between two otherwise-legitimate paired devices. Both device A
# and device B's SPKI fingerprints are genuinely in the Mac's trust store (invariant 3: trust is
# bound to SPKI fingerprints only, so an `openssl`-generated cert whose fingerprint is seeded is
# exactly as "paired" to the Mac as a real device's), but the connection presents device A's
# *certificate* while signing the TLS 1.3 `CertificateVerify` with device B's *private key*. The
# Mac must verify that signature against the public key actually embedded in the presented
# certificate (A's), never trust the fingerprint alone -- a mismatched signature fails the TLS
# handshake itself, before any CONTROL frame is ever exchanged.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-10-common.sh
source "$here/../lib/e15-10-common.sh"
trap e15_10_teardown EXIT

e15_10_setup_mac
e15_10_mktmp
e15_10_build_mismatch_tools

e15_10_gen_cert "$E15_10_TMP_DIR/deviceA" deviceA.tandem.test
e15_10_gen_cert "$E15_10_TMP_DIR/deviceB" deviceB.tandem.test
FP_A_HEX="$(e15_10_spki_fingerprint_hex "$E15_10_TMP_DIR/deviceA-cert.pem")"
FP_B_HEX="$(e15_10_spki_fingerprint_hex "$E15_10_TMP_DIR/deviceB-cert.pem")"

e15_10_seed_trust "$FP_A_HEX" "device A" "$E15_10_TMP_DIR/seed-a.json"
e15_10_seed_trust "$FP_B_HEX" "device B" "$E15_10_TMP_DIR/seed-b.json"

PORT=$(( (RANDOM % 20000) + 20000 ))
e15_10_launch_plain "$PORT"
e15_10_log "seeded devices A ($FP_A_HEX) and B ($FP_B_HEX) into the Mac's real trust store"

FAILED=0

# Positive control (same tool, same code path, device A's genuinely matched cert+key this time):
# an already-trusted device must be able to complete a real handshake, so the mismatched case
# below failing can't just be this test double being unable to complete any handshake at all.
control_output="$(e15_10_mismatched_cert_client 127.0.0.1 "$PORT" "$E15_10_TMP_DIR/deviceA-cert.pem" "$E15_10_TMP_DIR/deviceA-key.pem")"
e15_10_log "positive control (device A's own matched cert+key): $control_output"
if ! printf '%s\n' "$control_output" | grep -q '^HANDSHAKE_OK'; then
  e15_10_log "FAIL: positive control did not complete the handshake, got: $control_output -- the mismatched case below is not meaningful"
  FAILED=1
fi

output="$(e15_10_mismatched_cert_client 127.0.0.1 "$PORT" "$E15_10_TMP_DIR/deviceA-cert.pem" "$E15_10_TMP_DIR/deviceB-key.pem")"
e15_10_load_mismatch_ms
e15_10_log "raw TLS client (device A's cert, device B's key) took ${E15_10_LAST_MISMATCH_MS}ms"
e15_10_log "--- raw client output ---"
printf '%s\n' "$output" >&2

# Must be a genuine signature/decrypt rejection (TLS alert 51, decrypt_error), not merely
# "certificate required" (an anonymous-client rejection) and not a HANDSHAKE_TIMEOUT (the peer
# silently hanging is not evidence of rejection).
case "$output" in
  *HANDSHAKE_TIMEOUT*)
    e15_10_log "FAIL: the Mac never responded within the read deadline -- not evidence of rejection, got: $output"
    FAILED=1
    ;;
  *HANDSHAKE_FAILED*)
    ;;
  *)
    e15_10_log "FAIL: expected HANDSHAKE_FAILED, got: $output"
    FAILED=1
    ;;
esac
if [ "$FAILED" -eq 0 ]; then
  output_lower="$(printf '%s' "$output" | tr '[:upper:]' '[:lower:]')"
  case "$output_lower" in
    *"certificate required"*|*"certificate_required"*|*"bad_certificate"*)
      e15_10_log "FAIL: rejected as an anonymous client (no cert), not as a bad signature -- indistinguishable from scenario 1, got: $output"
      FAILED=1
      ;;
  esac
fi
if [ -z "$E15_10_LAST_MISMATCH_MS" ] || [ "$E15_10_LAST_MISMATCH_MS" -ge 5000 ]; then
  e15_10_log "FAIL: handshake took ${E15_10_LAST_MISMATCH_MS:-<none>}ms, expected < 5000ms"
  FAILED=1
fi

e15_10_assert_mac_alive "$PORT" || FAILED=1

TRUST_COUNT="$(e15_10_trust_record_count)"
if [ "$TRUST_COUNT" != "2" ]; then
  e15_10_log "FAIL: expected both device trust records to remain (2), found $TRUST_COUNT"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: handshakeRejected"
else
  echo "OUTCOME: FAILED"
fi
