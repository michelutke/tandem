#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_zeroRttEarlyData_zeroEarlyBytesDelivered
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(ZERO_EARLY_DATA)
# mitm-scenario-timeout: 180
#
# E15-11 (3/6): a client sending 0-RTT early data against the real Mac listener. 0-RTT requires a
# resumption PSK from a prior session's ticket -- the sibling `mitmLab_fullHandshake_
# zeroSessionTicketsIssued` scenario already establishes the real Mac never issues one, so this
# script's own step 1 (a real full handshake against the Mac) always leaves `openssl`'s `-sess_out`
# file empty too. That does not make the attempt uncomputable, though: this scenario's positive
# control below (a throwaway ticket-issuing server) already produces a forged ticket file
# (`control-session.pem`) that works perfectly well as a `-sess_in`/`-early_data` argument against
# the real Mac -- the Mac never issued it, so it won't be accepted, but the point is to prove the
# Mac correctly rejects/ignores a foreign ticket and falls back to a full handshake rather than that
# an attempt is impossible to construct. Step 2 below makes exactly that real attempt.
#
# Positive control: the identical `-sess_in ... -early_data ...` invocation against a throwaway
# `openssl s_server` that DOES support 0-RTT resumption reports "Early data was accepted" --
# proving this script's detection would catch a real acceptance rather than the negative case
# being vacuously true because the check itself never fires either way.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-11-common.sh
source "$here/../lib/e15-11-common.sh"
trap e15_11_teardown EXIT

e15_11_setup_mac

PORT="$(e15_11_free_port)"
e15_11_launch_plain "$PORT"

e15_11_gen_cert "$E15_11_TMP_DIR/client" "e15-11 client"
CLIENT_FP_HEX="$(e15_11_spki_fingerprint_hex "$E15_11_TMP_DIR/client-cert.pem")"
e15_11_seed_trust "$CLIENT_FP_HEX" "E15-11 seeded client" "$E15_11_TMP_DIR/seed.json"

CERT="$E15_11_TMP_DIR/client-cert.pem"
KEY="$E15_11_TMP_DIR/client-key.pem"
SESSION="$E15_11_TMP_DIR/session.pem"
EARLY_DATA_FILE="$E15_11_TMP_DIR/early-data.txt"
printf 'e15-11 forged 0-RTT payload\n' > "$EARLY_DATA_FILE"
FAILED=0

client_sent_certificate() {
  printf '%s' "$1" | grep -q '^>>> TLS 1\.3, Handshake \[length [0-9a-f]*\], Certificate$'
}

e15_11_log "step 1: a real full handshake against the Mac to see whether any resumable session results"
{ sleep 2; } | timeout 15 openssl s_client -connect "127.0.0.1:$PORT" -tls1_3 -alpn tandem/1 \
  -cert "$CERT" -key "$KEY" -sess_out "$SESSION" >/dev/null 2>&1 || true

e15_11_assert_mac_alive "$PORT" || FAILED=1

if [ -s "$SESSION" ]; then
  e15_11_log "a session file was unexpectedly written by step 1 -- 0 tickets is no longer a given, but step 2 below (using a forged ticket) still runs regardless"
fi

e15_11_log "positive control: -early_data attempt against a 0-RTT-capable throwaway server, to produce a forged ticket and prove detection isn't vacuous"
CONTROL_PORT="$(e15_11_free_port)"
openssl s_server -accept "$CONTROL_PORT" -cert "$CERT" -key "$KEY" -alpn tandem/1 \
  -no_ssl3 -no_tls1 -no_tls1_1 -no_tls1_2 -verify 0 -early_data -quiet >"$E15_11_TMP_DIR/control-server.log" 2>&1 &
CONTROL_SERVER_PID=$!
sleep 1
{ sleep 2; } | openssl s_client -connect "127.0.0.1:$CONTROL_PORT" -tls1_3 -alpn tandem/1 \
  -cert "$CERT" -key "$KEY" -sess_out "$E15_11_TMP_DIR/control-session.pem" >/dev/null 2>&1 || true
control_early_out="$( { sleep 2; } | openssl s_client -connect "127.0.0.1:$CONTROL_PORT" -tls1_3 -alpn tandem/1 \
  -cert "$CERT" -key "$KEY" -sess_in "$E15_11_TMP_DIR/control-session.pem" -early_data "$EARLY_DATA_FILE" 2>&1 || true)"
kill "$CONTROL_SERVER_PID" 2>/dev/null || true
wait "$CONTROL_SERVER_PID" 2>/dev/null || true

if printf '%s' "$control_early_out" | grep -qi 'early data was accepted'; then
  e15_11_log "OK: the positive control's own early data was accepted -- the negative-case rejection below is meaningful"
else
  e15_11_log "FAIL: the positive control never accepted early data either -- this detection method is vacuous:"
  printf '%s\n' "$control_early_out" >&2
  FAILED=1
fi

if [ -s "$E15_11_TMP_DIR/control-session.pem" ]; then
  e15_11_log "step 2: attempting 0-RTT early data against the real Mac using the control server's ticket (forged -- the Mac never issued it)"
  early_out="$( { sleep 2; } | timeout 15 openssl s_client -connect "127.0.0.1:$PORT" -tls1_3 -alpn tandem/1 \
    -cert "$CERT" -key "$KEY" -sess_in "$E15_11_TMP_DIR/control-session.pem" -early_data "$EARLY_DATA_FILE" -msg 2>&1 || true)"
  if printf '%s' "$early_out" | grep -qi 'early data was rejected'; then
    e15_11_log "OK: the real Mac explicitly rejected the forged early data"
  elif printf '%s' "$early_out" | grep -qi 'early data was accepted'; then
    e15_11_log "FAIL: the real Mac accepted the forged early data:"
    printf '%s\n' "$early_out" >&2
    FAILED=1
  else
    e15_11_log "FAIL: no explicit early-data rejection/acceptance line observed:"
    printf '%s\n' "$early_out" >&2
    FAILED=1
  fi
  if client_sent_certificate "$early_out"; then
    e15_11_log "OK: the connection nonetheless completed a full handshake (Certificate sent)"
  else
    e15_11_log "FAIL: the connection never completed a full handshake after the forged early-data attempt:"
    printf '%s\n' "$early_out" >&2
    FAILED=1
  fi
  e15_11_assert_mac_alive "$PORT" || FAILED=1
else
  e15_11_log "FAIL: the positive control never produced a ticket file to forge against the real Mac with"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: closedWithCode(ZERO_EARLY_DATA)"
else
  echo "OUTCOME: FAILED"
fi
