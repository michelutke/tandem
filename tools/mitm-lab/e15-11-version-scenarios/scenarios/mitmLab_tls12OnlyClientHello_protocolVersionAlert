#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_tls12OnlyClientHello_protocolVersionAlert
# mitm-scenario-role: client
# mitm-scenario-expect: handshakeRejected
# mitm-scenario-timeout: 180
#
# E15-11 (1/6): a TLS 1.2-only ClientHello (no TLS 1.3 offered) against the real Mac listener,
# which `NWListenerFactory` configures `sec_protocol_options_set_min/max_tls_protocol_version` to
# TLS 1.3 only. Asserts the specific alert name (`protocol_version`), not just "the handshake
# failed" -- the E15-10 lesson: a generic failure could just as easily be a TCP-level refusal, an
# unrelated cert problem, or this tool silently doing nothing. `openssl s_client -msg` prints every
# handshake message it exchanges, including the peer's alert; grepping for the *specific* fatal
# alert name is the same specificity E15-10's mismatched-cert scenarios settled on after their own
# vacuous-result finding.
#
# Positive control: the exact same seeded client identity, offered over TLS 1.3, must NOT see this
# alert (it gets past version negotiation entirely) -- isolating "TLS 1.2 only" as the one variable
# that produced the alert, rather than something wrong with the cert/seeding/port this script set
# up.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-11-common.sh
source "$here/../lib/e15-11-common.sh"
trap e15_11_teardown EXIT

e15_11_setup_mac

PORT="$(e15_11_free_port)"
e15_11_launch_plain "$PORT"

e15_11_gen_cert "$E15_11_TMP_DIR/client" "e15-11 client"
CLIENT_FP_HEX="$(e15_11_spki_fingerprint_hex "$E15_11_TMP_DIR/client-cert.pem")"
e15_11_seed_trust "$CLIENT_FP_HEX" "E15-11 seeded client" "$E15_11_TMP_DIR/seed.json"

FAILED=0

e15_11_log "negative case: TLS 1.2-only ClientHello"
negative_out="$(timeout 10 openssl s_client -connect "127.0.0.1:$PORT" -tls1_2 -alpn tandem/1 -msg </dev/null 2>&1 || true)"
if printf '%s' "$negative_out" | grep -qi 'fatal protocol_version'; then
  e15_11_log "OK: observed a fatal protocol_version alert"
else
  e15_11_log "FAIL: no fatal protocol_version alert observed:"
  printf '%s\n' "$negative_out" >&2
  FAILED=1
fi

e15_11_assert_mac_alive "$PORT" || FAILED=1

e15_11_log "positive control: same seeded client cert, TLS 1.3 (must NOT see protocol_version)"
positive_out="$(timeout 10 openssl s_client -connect "127.0.0.1:$PORT" -tls1_3 -alpn tandem/1 \
  -cert "$E15_11_TMP_DIR/client-cert.pem" -key "$E15_11_TMP_DIR/client-key.pem" -msg </dev/null 2>&1 || true)"
if printf '%s' "$positive_out" | grep -qi 'fatal protocol_version'; then
  e15_11_log "FAIL: the positive control (TLS 1.3) also saw a protocol_version alert -- tooling is broken"
  FAILED=1
elif printf '%s' "$positive_out" | grep -qi 'New, TLSv1.3, Cipher is'; then
  e15_11_log "OK: positive control completed a real TLS 1.3 handshake"
else
  e15_11_log "FAIL: positive control did not complete a TLS 1.3 handshake either:"
  printf '%s\n' "$positive_out" >&2
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: handshakeRejected"
else
  echo "OUTCOME: FAILED"
fi
