#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_fullHandshake_zeroSessionTicketsIssued
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(ZERO_TICKETS)
# mitm-scenario-timeout: 180
#
# E15-11 (2/6): a full, genuine mTLS handshake against the real Mac listener must never issue a
# TLS 1.3 `NewSessionTicket` message. `NWListenerFactory` sets
# `sec_protocol_options_set_tls_tickets_enabled(sec, false)` -- this scenario verifies that config
# actually has the claimed effect on the wire, rather than trusting the call exists (E15-10's
# lesson: a config knob that silently doesn't do what its name says is exactly the class of bug a
# code comment can't catch). `openssl s_client -msg` prints every handshake message exchanged,
# including any post-handshake `NewSessionTicket`; this script waits out this connection's whole
# lifetime (it closes on its own once `VersionHandshake`'s 5 s hello deadline elapses -- this
# `openssl` client never speaks the app-layer CONTROL protocol) and counts `NewSessionTicket`
# occurrences in that trace.
#
# Positive control: the same detection method (count `NewSessionTicket` in an `-msg` trace) run
# against a throwaway `openssl s_server` that has NOT disabled tickets must find at least one --
# proving a real ticket, if the Mac ever issued one, would not silently go undetected here.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-11-common.sh
source "$here/../lib/e15-11-common.sh"
trap e15_11_teardown EXIT

e15_11_setup_mac

PORT="$(e15_11_free_port)"
e15_11_launch_plain "$PORT"

e15_11_gen_cert "$E15_11_TMP_DIR/client" "e15-11 client"
CLIENT_FP_HEX="$(e15_11_spki_fingerprint_hex "$E15_11_TMP_DIR/client-cert.pem")"
e15_11_seed_trust "$CLIENT_FP_HEX" "E15-11 seeded client" "$E15_11_TMP_DIR/seed.json"

CERT="$E15_11_TMP_DIR/client-cert.pem"
KEY="$E15_11_TMP_DIR/client-key.pem"
FAILED=0

e15_11_log "full mTLS handshake against the real Mac, holding the connection open a couple of seconds"
# A `NewSessionTicket`, if the peer ever sends one, arrives asynchronously right after the
# handshake completes -- `</dev/null` would close this client's stdin (and so the connection)
# before any such message could ever arrive, making a "0 tickets" reading vacuous. Holding stdin
# open via a lingering `sleep` (proven against a real ticket-issuing server below) is what makes
# this observation meaningful.
mac_out="$( { sleep 2; } | timeout 15 openssl s_client -connect "127.0.0.1:$PORT" -tls1_3 -alpn tandem/1 \
  -cert "$CERT" -key "$KEY" -msg -sess_out "$E15_11_TMP_DIR/session.pem" 2>&1 || true)"

if ! printf '%s' "$mac_out" | grep -qi 'New, TLSv1.3, Cipher is'; then
  e15_11_log "FAIL: the full handshake never actually completed:"
  printf '%s\n' "$mac_out" >&2
  FAILED=1
fi

TICKET_COUNT="$(printf '%s' "$mac_out" | grep -c 'NewSessionTicket' || true)"
e15_11_log "NewSessionTicket count observed from the real Mac: $TICKET_COUNT"
if [ "$TICKET_COUNT" != "0" ]; then
  e15_11_log "FAIL: expected 0 NewSessionTicket messages, saw $TICKET_COUNT"
  FAILED=1
fi

e15_11_assert_mac_alive "$PORT" || FAILED=1

e15_11_log "positive control: same detection method against a server that has NOT disabled tickets"
CONTROL_PORT="$(e15_11_free_port)"
openssl s_server -accept "$CONTROL_PORT" -cert "$CERT" -key "$KEY" -alpn tandem/1 \
  -no_ssl3 -no_tls1 -no_tls1_1 -no_tls1_2 -quiet >"$E15_11_TMP_DIR/control-server.log" 2>&1 &
CONTROL_SERVER_PID=$!
sleep 1
control_out="$( { sleep 2; } | timeout 10 openssl s_client -connect "127.0.0.1:$CONTROL_PORT" -tls1_3 -alpn tandem/1 -msg 2>&1 || true)"
kill "$CONTROL_SERVER_PID" 2>/dev/null || true
wait "$CONTROL_SERVER_PID" 2>/dev/null || true

CONTROL_TICKET_COUNT="$(printf '%s' "$control_out" | grep -c 'NewSessionTicket' || true)"
e15_11_log "NewSessionTicket count observed from the ticket-issuing control server: $CONTROL_TICKET_COUNT"
if [ "$CONTROL_TICKET_COUNT" = "0" ]; then
  e15_11_log "FAIL: the positive control issued 0 tickets too -- this detection method is vacuous"
  FAILED=1
else
  e15_11_log "OK: the positive control's own ticket(s) were detected -- the negative-case count of 0 is meaningful"
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: closedWithCode(ZERO_TICKETS)"
else
  echo "OUTCOME: FAILED"
fi
