#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_androidClientAfterTicketIssued_nextHelloOffersNoPsk
# mitm-scenario-role: server
# mitm-scenario-expect: closedWithCode(NO_PSK_OFFERED)
# mitm-scenario-timeout: 120
#
# E15-11 (5/6, Cycle 4): a scripted server issues a real TLS 1.3 `NewSessionTicket` to the real JVM
# (Android `core/crypto`/`core/transport`) harness client, then inspects that same client's *next*
# `ClientHello` for `pre_shared_key`/`early_data` extensions. `SslClientFactory`'s own kdoc already
# claims "a fresh SSLContext is created per connection... the client never offers a PSK identity on
# a subsequent connection" -- this scenario verifies that claim empirically (E15-10's lesson: a
# design comment is not itself evidence) rather than trusting it, using `lib/
# ticket_probe_server.go` (a real Go `crypto/tls` TLS 1.3 server, tickets left enabled -- its
# default -- so this connection's own `NewSessionTicket`(s) are genuine, not simulated) to both
# issue the ticket and, for the second connection, parse the raw ClientHello extension-type list
# (never terminating that second handshake, so there is nothing for this tool itself to accept or
# reject).
#
# No real Mac app is involved: this is a scripted-server attack against the real client, exactly
# the E15-10 "impostor server" scenario's role, and the client only needs *a* certificate to
# authenticate against (the server's `ClientAuth: RequireAnyClientCert` never checks whose it is,
# invariant 3), so no `-HarnessSeedTrust` fixture is needed either -- the JVM client pins the
# server's own self-signed fingerprint directly via the existing `CONNECT` command.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-11-common.sh
source "$here/../lib/e15-11-common.sh"
trap e15_11_teardown EXIT

e15_11_setup_jvm
e15_11_build_go_tools

e15_11_gen_cert "$E15_11_TMP_DIR/server" "e15-11 ticket-probe server"
SERVER_FP_HEX="$(e15_11_spki_fingerprint_hex "$E15_11_TMP_DIR/server-cert.pem")"
SERVER_FP_B64="$(e15_11_hex_to_b64url "$SERVER_FP_HEX")"
PORT="$(e15_11_free_port)"

e15_11_start_ticket_probe_server "$PORT" "$E15_11_TMP_DIR/server-cert.pem" "$E15_11_TMP_DIR/server-key.pem"

FAILED=0

e15_11_start_client
e15_11_log "connection 1: real JVM client dialing the scripted ticket-issuing server"
e15_11_send "CONNECT 127.0.0.1 $PORT $SERVER_FP_B64"
# `lib/ticket_probe_server.go` closes this first connection itself, ~300ms after the real TLS
# handshake (and ticket issuance) complete -- it never idles out to a timeout. That close makes
# `VersionHandshake.kt`'s `.first{}` (waiting on frames that will never arrive, since the scripted
# server never speaks this protocol's app-layer CONTROL framing) throw "Expected at least one
# element matching the predicate"; the harness's `classify()` function labels that as PIN_MISMATCH.
# That is a harness LOG LABEL for "the connection ended before a VersionHello arrived", not an
# actual pin-mismatch failure -- expected and irrelevant to this scenario's assertions, but stated
# here precisely so a future reader isn't alarmed seeing "ERROR PIN_MISMATCH" below. Note also that
# this scenario proves the ticket was ISSUED and the client's next ClientHello offers no PSK; it does
# not itself prove the client actually consumed/read the ticket bytes off the wire.
conn1_line="$(e15_11_read 12)" || { e15_11_log "FAIL: no response at all to CONNECT (attempt 1)"; FAILED=1; }
e15_11_log "CONNECT (attempt 1) -> ${conn1_line:-<no response>}"

e15_11_log "connection 2: the same real JVM client process dialing again, right after a ticket was issued"
e15_11_send "CONNECT 127.0.0.1 $PORT $SERVER_FP_B64"
conn2_line="$(e15_11_read 12)" || { e15_11_log "FAIL: no response at all to CONNECT (attempt 2)"; FAILED=1; }
e15_11_log "CONNECT (attempt 2) -> ${conn2_line:-<no response>}"

e15_11_stop_client

# Give the server's background goroutines a moment to finish writing their stdout lines.
sleep 0.5
server_out="$(cat "$E15_11_TMP_DIR/ticket_probe_server.out" 2>/dev/null || true)"
e15_11_log "ticket-probe server output:"
printf '%s\n' "$server_out" >&2

if ! printf '%s' "$server_out" | grep -q '^HANDSHAKE1_OK$'; then
  e15_11_log "FAIL: the first (ticket-issuing) handshake never completed"
  FAILED=1
fi

extensions_line="$(printf '%s' "$server_out" | grep '^CLIENTHELLO2_EXTENSIONS ' || true)"
if [ -z "$extensions_line" ]; then
  e15_11_log "FAIL: the server never captured a second ClientHello to inspect"
  FAILED=1
else
  e15_11_log "second ClientHello extensions: ${extensions_line#CLIENTHELLO2_EXTENSIONS }"
fi

if printf '%s' "$server_out" | grep -q '^CLIENTHELLO2_PSK true$'; then
  e15_11_log "FAIL: the second ClientHello carried a pre_shared_key extension"
  FAILED=1
elif printf '%s' "$server_out" | grep -q '^CLIENTHELLO2_PSK false$'; then
  e15_11_log "OK: the second ClientHello carried no pre_shared_key extension"
else
  e15_11_log "FAIL: no CLIENTHELLO2_PSK line at all"
  FAILED=1
fi

if printf '%s' "$server_out" | grep -q '^CLIENTHELLO2_EARLYDATA true$'; then
  e15_11_log "FAIL: the second ClientHello carried an early_data extension"
  FAILED=1
elif printf '%s' "$server_out" | grep -q '^CLIENTHELLO2_EARLYDATA false$'; then
  e15_11_log "OK: the second ClientHello carried no early_data extension"
else
  e15_11_log "FAIL: no CLIENTHELLO2_EARLYDATA line at all"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: closedWithCode(NO_PSK_OFFERED)"
else
  echo "OUTCOME: FAILED"
fi
