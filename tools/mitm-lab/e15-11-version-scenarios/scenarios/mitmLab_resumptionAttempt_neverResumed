#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_resumptionAttempt_neverResumed
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(NEVER_RESUMED)
# mitm-scenario-timeout: 180
#
# E15-11 (2/6): after a real full mTLS handshake against the real Mac listener, an attempt to
# resume that session -- once with the (necessarily ticket-less, see the sibling
# `mitmLab_fullHandshake_zeroSessionTicketsIssued` scenario) saved session file, once with a
# forged out-of-band PSK identity -- must never actually resume: either it falls back to a full
# handshake (this client's own `Certificate`/`CertificateVerify` messages are sent again -- a
# genuinely resumed TLS 1.3 handshake skips both, since client authentication would already be
# bound to the PSK) or the connection is rejected outright. Distinguishing "fell back to full" from
# "silently resumed" by the presence of the client's own outgoing `Certificate` message in
# `openssl s_client -msg`'s trace is the same specificity discipline as the sibling scenario's
# `NewSessionTicket` count -- "the handshake succeeded" alone would not tell them apart.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e15-11-common.sh
source "$here/../lib/e15-11-common.sh"
trap e15_11_teardown EXIT

e15_11_setup_mac

PORT="$(e15_11_free_port)"
e15_11_launch_plain "$PORT"

e15_11_gen_cert "$E15_11_TMP_DIR/client" "e15-11 client"
CLIENT_FP_HEX="$(e15_11_spki_fingerprint_hex "$E15_11_TMP_DIR/client-cert.pem")"
e15_11_seed_trust "$CLIENT_FP_HEX" "E15-11 seeded client" "$E15_11_TMP_DIR/seed.json"

CERT="$E15_11_TMP_DIR/client-cert.pem"
KEY="$E15_11_TMP_DIR/client-key.pem"
SESSION="$E15_11_TMP_DIR/session.pem"
FAILED=0

client_sent_certificate() {
  printf '%s' "$1" | grep -q '^>>> TLS 1\.3, Handshake \[length [0-9a-f]*\], Certificate$'
}

e15_11_log "step 1: a real full handshake, holding the connection open long enough for any ticket"
first_out="$( { sleep 2; } | timeout 15 openssl s_client -connect "127.0.0.1:$PORT" -tls1_3 -alpn tandem/1 \
  -cert "$CERT" -key "$KEY" -msg -sess_out "$SESSION" 2>&1 || true)"
if ! client_sent_certificate "$first_out"; then
  e15_11_log "FAIL: the setup handshake itself never sent a Certificate -- can't proceed:"
  printf '%s\n' "$first_out" >&2
  FAILED=1
fi

e15_11_assert_mac_alive "$PORT" || FAILED=1

# TLS 1.3 session resumption is entirely ticket-based (no TLS 1.2-style session-ID cache): openssl
# only ever writes a `-sess_out` file when a `NewSessionTicket` actually arrived. Empirically, it
# writes nothing at all here (confirmed: `[ ! -s "$SESSION" ]` after this step, every run) -- itself
# consistent with the sibling `mitmLab_fullHandshake_zeroSessionTicketsIssued` scenario's own
# finding (0 tickets issued), not a failure of this script. There is therefore no ticket-based
# `-sess_in` attempt to make at all; only the forged-PSK attempt (step 2 below) is actually
# possible against this real, ticket-less Mac.
if [ -s "$SESSION" ]; then
  e15_11_log "step 2: resumption attempt with the saved session (a ticket was unexpectedly written)"
  resume_out="$( { sleep 2; } | timeout 15 openssl s_client -connect "127.0.0.1:$PORT" -tls1_3 -alpn tandem/1 \
    -cert "$CERT" -key "$KEY" -msg -sess_in "$SESSION" 2>&1 || true)"
  if client_sent_certificate "$resume_out"; then
    e15_11_log "OK: the -sess_in attempt fell back to a full handshake (Certificate sent again)"
  elif printf '%s' "$resume_out" | grep -qi 'New, TLSv1.3, Cipher is'; then
    e15_11_log "FAIL: the -sess_in attempt completed a handshake without ever re-sending Certificate -- looks resumed:"
    printf '%s\n' "$resume_out" >&2
    FAILED=1
  else
    e15_11_log "OK: the -sess_in attempt was rejected outright"
  fi
  e15_11_assert_mac_alive "$PORT" || FAILED=1
else
  e15_11_log "step 2 skipped: no session file to resume from (0 tickets issued, as expected)"
fi

if [ "$FAILED" -eq 0 ]; then
  e15_11_log "step 3 (the only resumption attempt actually possible here): forged out-of-band PSK identity"
  psk_out="$( { sleep 2; } | timeout 15 openssl s_client -connect "127.0.0.1:$PORT" -tls1_3 -alpn tandem/1 \
    -cert "$CERT" -key "$KEY" -msg -psk_identity forged-e15-11-identity -psk aabbccddeeff00112233445566778899 2>&1 || true)"
  if client_sent_certificate "$psk_out"; then
    e15_11_log "OK: the forged-PSK attempt fell back to a full handshake (Certificate sent again)"
  elif printf '%s' "$psk_out" | grep -qi 'New, TLSv1.3, Cipher is'; then
    e15_11_log "FAIL: the forged-PSK attempt completed a handshake without ever sending Certificate -- looks resumed:"
    printf '%s\n' "$psk_out" >&2
    FAILED=1
  else
    e15_11_log "OK: the forged-PSK attempt was rejected outright"
  fi
  e15_11_assert_mac_alive "$PORT" || FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: closedWithCode(NEVER_RESUMED)"
else
  echo "OUTCOME: FAILED"
fi
