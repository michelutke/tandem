#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_authenticatedControlFlood200PerSecond_closedWithLimitExceededTrustUnchanged
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(LIMIT_EXCEEDED)
# mitm-scenario-timeout: 300
#
# E20-20: an authenticated paired phone floods non-Heartbeat CONTROL frames (zero-amount CreditGrant) at 200/s, past the D-61 cap of 60/s; the Mac closes the session with LIMIT_EXCEEDED and its trust store/pin is unchanged.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e20-20-common.sh
source "$here/../lib/e20-20-common.sh"
trap e15_10_teardown EXIT

FAILED=0
e20_20_flood_and_report CONTROL 200 5 || FAILED=1

if [ "$FAILED" -eq 0 ] && ! e20_20_closed_with_limit_exceeded; then
  e20_20_log "FAIL: expected the Mac to close the session with LIMIT_EXCEEDED, got: $E20_20_FLOOD_LINE"
  FAILED=1
fi
if [ "$FAILED" -eq 0 ] && [ "$E20_20_TRUST_COUNT_AFTER" != "1" ]; then
  e20_20_log "FAIL: trust store changed, expected 1 record, found $E20_20_TRUST_COUNT_AFTER"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: closedWithCode(LIMIT_EXCEEDED)"
else
  echo "OUTCOME: FAILED"
fi
