#!/usr/bin/env bash
# mitm-scenario-name: mitmLab_authenticatedHeartbeatFlood1000PerSecond_closedWithLimitExceededTrustUnchanged
# mitm-scenario-role: client
# mitm-scenario-expect: closedWithCode(LIMIT_EXCEEDED)
# mitm-scenario-timeout: 300
#
# E20-20: an authenticated paired phone floods unsolicited Heartbeats at 1000/s; D-66 counts every Heartbeat the Mac receives toward the D-61 60/s cap, so the Mac closes with LIMIT_EXCEEDED and its trust store/pin is unchanged. (The phone-side D-60 reply cap is unit-tested by HeartbeatResponderTest; no Mac test double exists to flood a phone.)
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/e20-20-common.sh
source "$here/../lib/e20-20-common.sh"
trap e15_10_teardown EXIT

FAILED=0
e20_20_flood_and_report HEARTBEAT 1000 5 || FAILED=1

if [ "$FAILED" -eq 0 ] && ! e20_20_closed_with_limit_exceeded; then
  e20_20_log "FAIL: expected the Mac to close the session with LIMIT_EXCEEDED, got: $E20_20_FLOOD_LINE"
  FAILED=1
fi
if [ "$FAILED" -eq 0 ] && [ "$E20_20_TRUST_COUNT_AFTER" != "1" ]; then
  e20_20_log "FAIL: trust store changed, expected 1 record, found $E20_20_TRUST_COUNT_AFTER"
  FAILED=1
fi

if [ "$FAILED" -eq 0 ]; then
  echo "OUTCOME: closedWithCode(LIMIT_EXCEEDED)"
else
  echo "OUTCOME: FAILED"
fi
