<?xml version="1.0" encoding="utf-8"?>
<!--
E00-28: excludes every documented domain (root, file, database, sharedpref, external, and their
device_* device-transfer counterparts) from both <cloud-backup> and <device-transfer>, so nothing
(trust store, settings, transfer temp files) ever leaves the device by either path. `domain="root"`
alone is NOT sufficient: Android runs one full-backup traversal per domain token
(BackupAgent#onFullBackup), each rooted at its own directory, so root only prunes the root
traversal and files/databases/shared_prefs/external/device-protected storage still transfer unless
each is excluded explicitly. `disableIfNoEncryptionCapabilities` additionally refuses an
unencrypted cloud-backup transport.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
