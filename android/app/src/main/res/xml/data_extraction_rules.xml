<?xml version="1.0" encoding="utf-8"?>
<!--
E00-28: excludes every domain from both cloud-backup and device-transfer, so nothing (trust
store, settings, transfer temp files) ever leaves the device by either path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
