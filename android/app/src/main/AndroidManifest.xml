<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- E20-02 permissions for TandemService (`connectedDevice` foreground-service type,
         docs/planning/backlog/phase-2.yaml E20-02, acceptance criterion 1):
           - FOREGROUND_SERVICE: base platform permission every foreground service needs
             regardless of type (mandatory since API 28).
           - FOREGROUND_SERVICE_CONNECTED_DEVICE: the per-type permission Android 14 requires for
             the `connectedDevice` type, named explicitly in E20-02's issue body.
           - CHANGE_NETWORK_STATE: the E20-02 issue body's own choice of `connectedDevice` runtime
             prerequisite ("does not require a CDM association"); SPEC.md's heartbeat/Doze section
             assumes this service runs with unrestricted battery.
           - POST_NOTIFICATIONS: required on API 33+ to actually show the mandatory ongoing
             notification E20-02's acceptance criteria call for (runtime request flow is a later
             onboarding issue; this is only the manifest half). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- E23-05: lets RingHandler read/set the Do Not Disturb interruption filter so a Ring can
         switch total silence (NONE) to ALARMS for the duration of the ring; granted through the
         system's notification policy access settings (RingPolicyExplanationScreen), not a runtime
         permission dialog. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- E20-08: lets BootReceiver restart TandemService after first unlock (BOOT_COMPLETED is not
         direct-boot aware) without the user opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
    E00-28 platform-hardening baseline (invariants 1, 2, 4):
      - allowBackup/fullBackupContent off and dataExtractionRules excluding every domain: nothing
        (trust store, settings, transfer temp files) ever leaves the device via cloud backup or
        device transfer.
      - usesCleartextTraffic off plus a networkSecurityConfig with system trust anchors only;
        Tandem's own TLS still goes through the pinning TrustManager (E12-05) regardless.
    -->
    <application
        android:name=".TandemApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Not launchable and not exported; declared so tooling that enumerates <activity>
             entries (E00-28's activity-inheritance backstop) has at least one real entry to see. -->
        <activity android:name=".TandemActivity" android:exported="false" />

        <!-- E20-02: owns the control-connection lifecycle's on-screen presence (mandatory
             ongoing notification); started only when a paired Mac exists (ServiceStarter). -->
        <service
            android:name=".service.TandemService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- E20-08: restarts TandemService when a paired Mac exists. Exported so the system can
             deliver BOOT_COMPLETED (E00-28 allowlist entry below); onReceive itself ignores any
             action other than BOOT_COMPLETED/MY_PACKAGE_REPLACED as a defense-in-depth guard
             against an explicit intent from another app. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- E23-06: receives the ring notification's "Stop" action tap. Not exported: reached
             only via the explicit-component PendingIntent RingNotification builds for its own
             "Stop" action, never a manifest intent-filter. -->
        <receiver
            android:name=".ring.RingStopActionReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- E30-02: captures posted/removed notifications for mirroring (F-5.1). Exported and
             permission-guarded so only the system can bind it (E00-28 allowlist entry below);
             onNotificationPosted/Removed never write notification title/text to logcat
             (invariant 7, E00-17 lint rule). -->
        <service
            android:name="dev.tandem.feature.notifications.TandemNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
