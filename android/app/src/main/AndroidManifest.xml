<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- E20-02 permissions for TandemService (`connectedDevice` foreground-service type,
         docs/planning/backlog/phase-2.yaml E20-02, acceptance criterion 1):
           - FOREGROUND_SERVICE: base platform permission every foreground service needs
             regardless of type (mandatory since API 28).
           - FOREGROUND_SERVICE_CONNECTED_DEVICE: the per-type permission Android 14 requires for
             the `connectedDevice` type, named explicitly in E20-02's issue body.
           - CHANGE_NETWORK_STATE: the E20-02 issue body's own choice of `connectedDevice` runtime
             prerequisite ("does not require a CDM association"); SPEC.md's heartbeat/Doze section
             assumes this service runs with unrestricted battery.
           - POST_NOTIFICATIONS: required to actually show the mandatory ongoing
             notification E20-02's acceptance criteria call for (runtime request flow is a later
             onboarding issue; this is only the manifest half). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- E23-05: lets RingHandler read/set the Do Not Disturb interruption filter so a Ring can
         switch total silence (NONE) to ALARMS for the duration of the ring; granted through the
         system's notification policy access settings (RingPolicyExplanationScreen), not a runtime
         permission dialog. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- E20-08: lets BootReceiver restart TandemService after first unlock (BOOT_COMPLETED is not
         direct-boot aware) without the user opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- E20-04, D-80: lets onboarding and Settings open the direct "Let app always run in
         background?" dialog (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) so the live Mac
         connection (F-4.1) survives Doze. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Local network access (API 37+): without it the platform answers NsdManager browsing with a
         device-picker dialog; onboarding requests it and discovery is skipped while it is missing. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
    E00-28 platform-hardening baseline (invariants 1, 2, 4):
      - allowBackup/fullBackupContent off and dataExtractionRules excluding every domain: nothing
        (trust store, settings, transfer temp files) ever leaves the device via cloud backup or
        device transfer.
      - usesCleartextTraffic off plus a networkSecurityConfig with system trust anchors only;
        Tandem's own TLS still goes through the pinning TrustManager (E12-05) regardless.
    -->
    <application
        android:name=".TandemApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tandem"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- E20-02: owns the control-connection lifecycle's on-screen presence (mandatory
             ongoing notification); started only when a paired Mac exists (ServiceStarter). -->
        <service
            android:name=".service.TandemService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- E20-08: restarts TandemService when a paired Mac exists. Exported so the system can
             deliver BOOT_COMPLETED (E00-28 allowlist entry below); onReceive itself ignores any
             action other than BOOT_COMPLETED/MY_PACKAGE_REPLACED as a defense-in-depth guard
             against an explicit intent from another app. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- E23-06: receives the ring notification's "Stop" action tap. Not exported: reached
             only via the explicit-component PendingIntent RingNotification builds for its own
             "Stop" action, never a manifest intent-filter. -->
        <receiver
            android:name=".ring.RingStopActionReceiver"
            android:exported="false" />

        <!-- E62-11: transparent host for the system MediaProjection consent dialog. Not exported:
             reached only via the explicit-component intent AndroidMirrorPlatform builds. -->
        <activity
            android:name=".mirror.MirrorConsentActivity"
            android:exported="false"
            android:theme="@style/Theme.Tandem.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- E30-02: captures posted/removed notifications for mirroring (F-5.1). Exported and
             permission-guarded so only the system can bind it (E00-28 allowlist entry below);
             onNotificationPosted/Removed never write notification title/text to logcat
             (invariant 7, E00-17 lint rule). -->
        <service
            android:name="dev.tandem.feature.notifications.TandemNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- E31-06: "Send to Mac" share-sheet target (F-6.2/F-6.3, UC-13). ACTION_SEND text/plain
             only; file/stream sharing is a separate future issue (E40-11). Exported so the
             system can resolve it from another app's share sheet (E00-28 allowlist entry below);
             no permission guard needed, matching MainActivity/BootReceiver. -->
        <activity
            android:name="dev.tandem.feature.clipboard.ShareTargetActivity"
            android:exported="true"
            android:label="@string/clipboard_send_to_mac_label"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- E40-11: "Send to Mac" share-sheet target for files (F-7.3). Exported so the system can
             resolve it from another app's share sheet (E00-28 allowlist entry); only content://
             streams are accepted, enforced in SendEntry. -->
        <activity
            android:name="dev.tandem.feature.files.ShareFilesActivity"
            android:exported="true"
            android:label="@string/clipboard_send_to_mac_label"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- E31-06: PROCESS_TEXT entry for selected text (F-6.2/F-6.3, UC-13). Reads
             EXTRA_PROCESS_TEXT only, ignores EXTRA_PROCESS_TEXT_READONLY. Exported so the system
             can resolve it from the text-selection menu (E00-28 allowlist entry below). -->
        <activity
            android:name="dev.tandem.feature.clipboard.ProcessTextActivity"
            android:exported="true"
            android:label="@string/clipboard_send_to_mac_label"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- E31-12: transparent capture activity started by the Quick Settings tile; reads the
             clipboard on window focus (background reads are blocked on Android 10+), sends it and
             finishes. Not exported: reached only via the tile's explicit-component intent. -->
        <activity
            android:name="dev.tandem.feature.clipboard.ClipboardCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.Tandem.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- E31-12: "Send clip" Quick Settings tile. Exported and permission-guarded so only the
             system can bind it (E00-28 allowlist entry). -->
        <service
            android:name="dev.tandem.feature.clipboard.ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_send_clip"
            android:label="@string/clipboard_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
