<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- ADR-007 / D-82: opt-in copy detector; exported so the system can bind it, guarded by
             BIND_ACCESSIBILITY_SERVICE so no other app can. -->
        <service
            android:name=".ClipboardCaptureService"
            android:exported="true"
            android:label="@string/clipboard_capture_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clipboard_capture_service" />
        </service>
    </application>

</manifest>
